# invoiceninja-bridge's settings. Copy to .env, fill in, chmod 600, and keep each value in your password manager too.
# A commented line keeps the default; uncomment it only to change that.

# noticebox: where it is, and a `read` API token (nbx_…) of the person who accepts the submissions. Required.
BRIDGE_NOTICEBOX_URL=https://inbox.example.org
BRIDGE_NOTICEBOX_TOKEN=

# The hook's secret: noticebox posts to <bridge>/hooks/noticebox/<this>. 32 or more random characters (openssl rand -hex 32). Required.
BRIDGE_HOOK_SECRET=

# Invoice Ninja v5: where it is, and an API token of a user who may view and create clients and quotes. Required.
BRIDGE_INVOICENINJA_URL=https://invoices.example.org
BRIDGE_INVOICENINJA_TOKEN=

# The mappings file inside the container: which form hands over in which state, and which fields are the client's. Default:
# /config/mappings.json
# BRIDGE_MAPPINGS=/config/mappings.json

# An ntfy topic for a push when a handover fails or is given up (https://ntfy.sh/<a secret topic>). Without it, only the log says so.
BRIDGE_NTFY_URL=

# The log's level: debug, info, warn, error or silent. Default: info
# BRIDGE_LOG_LEVEL=info

# Where bridge.sqlite lives. Default in the image: /data
# DATA_DIR=/data

# The port the server listens on. Default: 8080
# PORT=8080

# The time zone of the log's dates. Default: UTC
# TZ=Europe/Berlin

# The owner of /data inside the container. Default: the owner of the mounted folder (1000 if that is root)
# PUID=1000
# PGID=1000

# A file of extra CA certificates (PEM) to trust besides the image's, e.g. for an internal noticebox or Invoice Ninja.
# NODE_EXTRA_CA_CERTS=/certs/internal-ca.pem
